        --================================================--

        function Tab:AddSlider(options)

            options = options or {}

            local Name = options.Name or "Slider"

            local Min = options.Min or 0
            local Max = options.Max or 100

            local Value = options.Default or Min

            local Increment = options.Increment or 1

            local Callback = options.Callback or function() end

            Value = Clamp(Value, Min, Max)

            local Frame = Create("Frame", {
                Parent = Page,

                Size = UDim2.new(1, 0, 0, 65),

                BackgroundColor3 = Theme.Element,

                BorderSizePixel = 0
            })

            Corner(Frame, 7)
            Stroke(Frame)

            Create("TextLabel", {
                Parent = Frame,

                BackgroundTransparency = 1,

                Position = UDim2.fromOffset(13, 7),

                Size = UDim2.new(1, -90, 0, 20),

                Font = Enum.Font.GothamMedium,

                Text = Name,

                TextColor3 = Theme.Text,

                TextSize = 11,

                TextXAlignment = Enum.TextXAlignment.Left
            })

            local ValueLabel = Create("TextLabel", {
                Parent = Frame,

                BackgroundTransparency = 1,

                Position = UDim2.new(1, -75, 0, 7),

                Size = UDim2.fromOffset(60, 20),

                Font = Enum.Font.GothamMedium,

                Text = tostring(Value),

                TextColor3 = Theme.Accent,

                TextSize = 11,

                TextXAlignment = Enum.TextXAlignment.Right
            })

            local Bar = Create("Frame", {
                Parent = Frame,

                Position = UDim2.fromOffset(13, 42),

                Size = UDim2.new(1, -26, 0, 6),

                BackgroundColor3 = Theme.Slider,

                BorderSizePixel = 0
            })

            Corner(Bar, 5)

            local Fill = Create("Frame", {
                Parent = Bar,

                Size = UDim2.fromScale(
                    (Value - Min) / (Max - Min),
                    1
                ),

                BackgroundColor3 = Theme.Accent,

                BorderSizePixel = 0
            })

            Corner(Fill, 5)

            local Knob = Create("Frame", {
                Parent = Bar,

                AnchorPoint = Vector2.new(0.5, 0.5),

                Position = UDim2.new(
                    (Value - Min) / (Max - Min),
                    0,
                    0.5,
                    0
                ),

                Size = UDim2.fromOffset(12, 12),

                BackgroundColor3 = Theme.White,

                BorderSizePixel = 0
            })

            Corner(Knob, 6)

            local Sliding = false

            local function Round(Number)

                return math.floor(
                    Number / Increment + 0.5
                ) * Increment

            end

            local function SetFromMouse(MouseX)

                local Start = Bar.AbsolutePosition.X
                local Width = Bar.AbsoluteSize.X

                local Percent = Clamp(
                    (MouseX - Start) / Width,
                    0,
                    1
                )

                local NewValue =
                    Min + (Max - Min) * Percent

                NewValue = Clamp(
                    Round(NewValue),
                    Min,
                    Max
                )

                Value = NewValue

                local FinalPercent =
                    (Value - Min) / (Max - Min)

                ValueLabel.Text = tostring(Value)

                Tween(Fill, {
                    Size = UDim2.new(
                        FinalPercent,
                        0,
                        1,
                        0
                    )
                }, 0.05)

                Tween(Knob, {
                    Position = UDim2.new(
                        FinalPercent,
                        0,
                        0.5,
                        0
                    )
                }, 0.05)

                task.spawn(Callback, Value)
            end

            Bar.InputBegan:Connect(function(input)

                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then

                    Sliding = true

                    SetFromMouse(input.Position.X)

                end

            end)

            UserInputService.InputChanged:Connect(function(input)

                if not Sliding then
                    return
                end

                if input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch then

                    SetFromMouse(input.Position.X)

                end

            end)

            UserInputService.InputEnded:Connect(function(input)

                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then

                    Sliding = false

                end

            end)

            return {
                Instance = Frame,

                SetValue = function(_, NewValue)

                    NewValue = Clamp(
                        Round(NewValue),
                        Min,
                        Max
                    )

                    Value = NewValue

                    local Percent =
                        (Value - Min) / (Max - Min)

                    ValueLabel.Text = tostring(Value)

                    Fill.Size =
                        UDim2.new(
                            Percent,
                            0,
                            1,
                            0
                        )

                    Knob.Position =
                        UDim2.new(
                            Percent,
                            0,
                            0.5,
                            0
                        )

                    Callback(Value)

                end,

                GetValue = function()
                    return Value
                end
            }
        end

