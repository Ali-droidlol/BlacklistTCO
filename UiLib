    function Tab:AddSlider(options)

        options = options or {}

        local Name = options.Name or "Slider"
        local Min = options.Min or 0
        local Max = options.Max or 100
        local Default = options.Default or Min
        local Increment = options.Increment or 1

        local Callback = options.Callback or function() end

        local Value = Clamp(Default, Min, Max)

        local Frame = New("Frame", {
            Parent = Page,

            Size = UDim2.new(1, 0, 0, 65),

            BackgroundColor3 = Theme.Secondary,

            BorderSizePixel = 0
        })

        Corner(Frame, 7)
        Stroke(Frame, Theme.Border)

        local Label = New("TextLabel", {
            Parent = Frame,

            BackgroundTransparency = 1,

            Position = UDim2.fromOffset(13, 8),

            Size = UDim2.new(1, -100, 0, 20),

            Font = Enum.Font.GothamMedium,

            Text = Name,

            TextColor3 = Theme.Text,
            TextSize = 12,

            TextXAlignment = Enum.TextXAlignment.Left
        })

        local ValueLabel = New("TextLabel", {
            Parent = Frame,

            BackgroundTransparency = 1,

            Position = UDim2.new(1, -75, 0, 8),

            Size = UDim2.fromOffset(60, 20),

            Font = Enum.Font.GothamMedium,

            Text = tostring(Value),

            TextColor3 = Theme.Accent,
            TextSize = 12,

            TextXAlignment = Enum.TextXAlignment.Right
        })

        local SliderBackground = New("Frame", {
            Parent = Frame,

            Position = UDim2.new(0, 13, 1, -22),

            Size = UDim2.new(1, -26, 0, 6),

            BackgroundColor3 = Theme.SliderBackground,

            BorderSizePixel = 0
        })

        Corner(SliderBackground, 4)

        local SliderFill = New("Frame", {
            Parent = SliderBackground,

            Size = UDim2.new(0, 0, 1, 0),

            BackgroundColor3 = Theme.Accent,

            BorderSizePixel = 0
        })

        Corner(SliderFill, 4)

        local SliderKnob = New("Frame", {
            Parent = SliderBackground,

            AnchorPoint = Vector2.new(0.5, 0.5),

            Position = UDim2.fromScale(0, 0.5),

            Size = UDim2.fromOffset(12, 12),

            BackgroundColor3 = Theme.Text,

            BorderSizePixel = 0
        })

        Corner(SliderKnob, 6)

        local Sliding = false

        local function RoundValue(Number)

            if Increment <= 0 then
                return Number
            end

            local Rounded =
                math.floor(Number / Increment + 0.5) * Increment

            return Clamp(Rounded, Min, Max)
        end

        local function UpdateFromMouse(MouseX)

            local AbsolutePosition = SliderBackground.AbsolutePosition.X
            local AbsoluteSize = SliderBackground.AbsoluteSize.X

            local Percent =
                Clamp(
                    (MouseX - AbsolutePosition) / AbsoluteSize,
                    0,
                    1
                )

            Value = RoundValue(
                Min + ((Max - Min) * Percent)
            )

            local FinalPercent =
                (Value - Min) / (Max - Min)

            ValueLabel.Text = tostring(Value)

            Tween(SliderFill, {
                Size = UDim2.new(FinalPercent, 0, 1, 0)
            }, 0.05)

            Tween(SliderKnob, {
                Position = UDim2.new(FinalPercent, 0, 0.5, 0)
            }, 0.05)

            task.spawn(function()
                Callback(Value)
            end)
        end

        SliderBackground.InputBegan:Connect(function(input)

            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then

                Sliding = true

                UpdateFromMouse(input.Position.X)

            end

        end)

        UserInputService.InputChanged:Connect(function(input)

            if not Sliding then
                return
            end

            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then

                UpdateFromMouse(input.Position.X)

            end

        end)

        UserInputService.InputEnded:Connect(function(input)

            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then

                Sliding = false

            end

        end)

        local InitialPercent =
            (Value - Min) / (Max - Min)

        SliderFill.Size =
            UDim2.new(InitialPercent, 0, 1, 0)

        SliderKnob.Position =
            UDim2.new(InitialPercent, 0, 0.5, 0)

        return {
            Frame = Frame,

            SetValue = function(_, NewValue)

                Value = Clamp(
                    RoundValue(NewValue),
                    Min,
                    Max
                )

                local Percent =
                    (Value - Min) / (Max - Min)

                ValueLabel.Text = tostring(Value)

                Tween(SliderFill, {
                    Size = UDim2.new(Percent, 0, 1, 0)
                })

                Tween(SliderKnob, {
                    Position = UDim2.new(Percent, 0, 0.5, 0)
                })

                Callback(Value)

            end,

            GetValue = function()
                return Value
            end
        }

    end

