        New("TextLabel", {
            Parent = Frame,

            BackgroundTransparency = 1,

            Position = UDim2.fromOffset(13, 0),

            Size = UDim2.new(1, -120, 1, 0),

            Font = Enum.Font.GothamMedium,

            Text = Name,

            TextColor3 = Theme.Text,
            TextSize = 12,

            TextXAlignment = Enum.TextXAlignment.Left
        })

        local KeyButton = New("TextLabel", {
            Parent = Frame,

            Position = UDim2.new(1, -100, 0.5, -13),

            Size = UDim2.fromOffset(85, 26),

            BackgroundColor3 = Theme.Tertiary,

            Font = Enum.Font.GothamMedium,

            Text = CurrentKey.Name,

            TextColor3 = Theme.SubText,
            TextSize = 10
        })

        Corner(KeyButton, 5)

        Frame.MouseButton1Click:Connect(function()

            if Listening then
                return
            end

            Listening = true

            KeyButton.Text = "Press key..."

            Tween(KeyButton, {
                TextColor3 = Theme.Accent
            })

        end)

        UserInputService.InputBegan:Connect(function(input, processed)

            if Listening then

                if input.UserInputType == Enum.UserInputType.Keyboard then

                    CurrentKey = input.KeyCode

                    KeyButton.Text = CurrentKey.Name

                    Tween(KeyButton, {
                        TextColor3 = Theme.SubText
                    })

                    Listening = false

                end

                return
            end

            if processed then
                return
            end

            if input.KeyCode == CurrentKey then

                task.spawn(function()
                    Callback(CurrentKey)
                end)

            end

        end)

        return {
            Frame = Frame,

            SetKey = function(_, Key)
                CurrentKey = Key
                KeyButton.Text = Key.Name
            end,

            GetKey = function()
                return CurrentKey
            end
        }

    end

    --====================================================--
    --                     LABEL                           --
    --====================================================--

    function Tab:AddLabel(Text)

        local Label = New("TextLabel", {
            Parent = Page,

            Size = UDim2.new(1, 0, 0, 30),

            BackgroundTransparency = 1,

            Font = Enum.Font.Gotham,

            Text = Text,

            TextColor3 = Theme.SubText,

            TextSize = 11,

            TextWrapped = true,

            TextXAlignment = Enum.TextXAlignment.Left
        })

        return {
            Label = Label,

            SetText = function(_, NewText)
                Label.Text = NewText
            end
        }

    end

    --====================================================--
    --                   NOTIFICATION                     --
    --====================================================--

    function Tab:AddNotification(options)

        options = options or {}

        local TitleText = options.Title or "Notification"
        local Message = options.Message or ""
        local Duration = options.Duration or 3

        -- handled globally below
    end

    --====================================================--
    --                     FINISH                          --
    --====================================================--

    if #Tabs == 1 then
        SelectTab(Tab)
    end

    return Tab
end

