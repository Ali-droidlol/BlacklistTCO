local NotificationHolder = New("Frame", {
    Parent = ScreenGui,

    Position = UDim2.new(1, -15, 1, -15),

    Size = UDim2.fromOffset(300, 400),

    AnchorPoint = Vector2.new(1, 1),

    BackgroundTransparency = 1
})

local NotificationList = New("UIListLayout", {
    Parent = NotificationHolder,

    Padding = UDim.new(0, 8),

    SortOrder = Enum.SortOrder.LayoutOrder,

    VerticalAlignment = Enum.VerticalAlignment.Bottom
})

local function Notify(TitleText, Message, Duration)

    TitleText = TitleText or "Notification"
    Message = Message or ""
    Duration = Duration or 3

    local Notification = New("Frame", {
        Parent = NotificationHolder,

        Size = UDim2.fromOffset(300, 72),

        BackgroundColor3 = Theme.Secondary,

        BorderSizePixel = 0
    })

    Corner(Notification, 8)
    Stroke(Notification, Theme.Border)

    local Accent = New("Frame", {
        Parent = Notification,

        Position = UDim2.fromOffset(0, 0),

        Size = UDim2.fromOffset(4, 72),

        BackgroundColor3 = Theme.Accent,

        BorderSizePixel = 0
    })

    Corner(Accent, 3)

    New("TextLabel", {
        Parent = Notification,

        BackgroundTransparency = 1,

        Position = UDim2.fromOffset(16, 9),

        Size = UDim2.new(1, -28, 0, 20),

        Font = Enum.Font.GothamBold,

        Text = TitleText,

        TextColor3 = Theme.Text,

        TextSize = 12,

        TextXAlignment = Enum.TextXAlignment.Left
    })

    New("TextLabel", {
        Parent = Notification,

        BackgroundTransparency = 1,

        Position = UDim2.fromOffset(16, 30),

        Size = UDim2.new(1, -28, 0, 32),

        Font = Enum.Font.Gotham,

        Text = Message,

        TextColor3 = Theme.SubText,

        TextSize = 10,

        TextWrapped = true,

        TextXAlignment = Enum.TextXAlignment.Left,

        TextYAlignment = Enum.TextYAlignment.Top
    })

    Notification.Position =
        UDim2.new(1, 20, 0, 0)

    Tween(Notification, {
        Position = UDim2.new(0, 0, 0, 0)
    }, 0.25)

    task.delay(Duration, function()

        if Notification and Notification.Parent then

            Tween(Notification, {
                Position = UDim2.new(1, 20, 0, 0)
            }, 0.25)

            task.wait(0.3)

            Notification:Destroy()

        end

    end)

    return Notification
end

