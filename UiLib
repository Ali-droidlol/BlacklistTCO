            Tween(Existing.Label, {
                TextColor3 = Theme.SubText
            })

        end

        Tab.Page.Visible = true

        Tween(Tab.Button, {
            BackgroundColor3 = Theme.Element
        })

        Tween(Tab.Icon, {
            TextColor3 = Theme.Accent
        })

        Tween(Tab.Label, {
            TextColor3 = Theme.Text
        })

        CurrentTab = Tab
