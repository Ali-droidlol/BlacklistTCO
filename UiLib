                Enum.UserInputType.MouseButton1
            or
            Input.UserInputType ==
                Enum.UserInputType.Touch
        then

            Dragging = true

            DragStart =
                Input.Position

            StartPosition =
                Main.Position

            Input.Changed:Connect(
                function()

                    if
                        Input.UserInputState ==
                            Enum.UserInputState.End
                    then

                        Dragging = false

                    end

                end
            )

        end

